{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "The Citizen's Record",
  "description": "A source-based civic record, public research hub, and practical guide to working with information.",
  "colors": {
    "primary": "#1E3A5F",
    "light": "#3B82C4",
    "dark": "#16324F"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Start Here",
        "pages": ["index", "quickstart", "about-citizens-record"]
      },
      {
        "group": "Research Standards",
        "pages": ["methodology", "source-standards", "corrections"]
      },
      {
        "group": "Guides",
        "pages": ["records-guide", "legal-information"]
      },
      {
        "group": "Projects",
        "pages": ["projects", "ecosystem"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Citizen's Record",
          "href": "https://thomascallen16.github.io/The-Citizens-Record/",
          "icon": "landmark"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/Thomascallen16/docs",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Main Site",
        "href": "https://thomascallen16.github.io/The-Citizens-Record/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start Here",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/Thomascallen16/docs"
    }
  }
}